#!/bin/sh
# devkit-kit — portable resolver for the devkit checkers (design D9, AC-8 portable-hooks).
#
# Every template this kit ships calls the devkit checkers through this script, never through a
# path that exists in only one repository:
#
#     .compozy/bin/devkit-kit deliver-check --ci
#     .compozy/bin/devkit-kit conduct-check --change <id>
#     .compozy/bin/devkit-kit screens-check --change <id>
#
# Resolution order for `deliver-check` and `conduct-check`:
#   1. $DEVKIT_HOOKS       - a directory holding <subcommand>.mjs directly.
#   2. a repository checkout - plugins/openspec/hooks/<subcommand>.mjs, found by walking up
#                               from the caller's current directory.
#   3. an installed devkit-openspec - every directory under the Claude Code plugins directory
#      whose .claude-plugin/plugin.json names "devkit-openspec" and has a hooks/<subcommand>.mjs
#      sibling; the one with the highest "version" wins, compared field by field as integers
#      (never as a directory name, never by modification time); a tie is broken by the
#      lexicographically last path.
#
# `screens-check` resolves inside this pack (devkit-compozy), never in devkit-openspec, because
# it ships with devkit-compozy, not with devkit-openspec: $DEVKIT_HOOKS does not apply to it
# (that variable names the devkit-openspec checkers only). Its order is:
#   1. a repository checkout - plugins/compozy/skills/screen-design/scripts/screens-check.mjs,
#                               found the same way.
#   2. an installed devkit-compozy - same highest-version / tie-break rule as above, matched on
#      "devkit-compozy" and a skills/screen-design/scripts/screens-check.mjs sibling.
#
# The Claude Code plugins directory is "$CLAUDE_CONFIG_DIR/plugins" when $CLAUDE_CONFIG_DIR is
# set (the same variable Claude Code itself honours to relocate its config directory), else
# "$HOME/.claude/plugins". Set $CLAUDE_CONFIG_DIR to point the search at another tree entirely;
# this script's own tests use it to point at an isolated temp directory.
#
# Exits 3, naming every location it tried, when nothing resolves or the subcommand is unknown.

set -eu

plugins_dir() {
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    printf '%s/plugins' "$CLAUDE_CONFIG_DIR"
  else
    printf '%s/.claude/plugins' "$HOME"
  fi
}

# json_field <file> <key> — the string value of a top-level "<key>": "<value>" line.
json_field() {
  [ -f "$1" ] || return 1
  sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$1" | head -n1
}

# ver_cmp <a> <b> — echoes gt, lt or eq, comparing dotted fields as integers.
ver_cmp() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, A, ".");
    nb = split(b, B, ".");
    max = (na > nb ? na : nb);
    for (i = 1; i <= max; i++) {
      ai = (i <= na ? A[i] + 0 : 0);
      bi = (i <= nb ? B[i] + 0 : 0);
      if (ai > bi) { print "gt"; exit }
      if (ai < bi) { print "lt"; exit }
    }
    print "eq";
  }'
}

# path_gt <a> <b> — true (exit 0) when a sorts after b, byte-wise (LC_ALL=C).
path_gt() {
  [ "$1" = "$2" ] && return 1
  [ "$(printf '%s\n%s\n' "$1" "$2" | LC_ALL=C sort | tail -n1)" = "$1" ]
}

# find_repo_checkout <relative-path> — walks up from $PWD; echoes the matching ancestor on a
# hit.
find_repo_checkout() {
  rel="$1"
  dir=$PWD
  while :; do
    if [ -f "$dir/$rel" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    [ "$dir" = "/" ] && return 1
    dir=$(dirname "$dir")
  done
}

# find_installed <plugin-name> <relative-script-path> — echoes the winning plugin root on a
# hit (the directory holding .claude-plugin/plugin.json and <relative-script-path>).
find_installed() {
  plugin_name="$1"
  rel="$2"
  root=$(plugins_dir)
  [ -d "$root" ] || return 1

  best_path=""
  best_version=""
  found=0
  while IFS= read -r pj; do
    [ -f "$pj" ] || continue
    name=$(json_field "$pj" name || true)
    [ "$name" = "$plugin_name" ] || continue
    proot=$(dirname "$(dirname "$pj")")
    [ -f "$proot/$rel" ] || continue
    version=$(json_field "$pj" version || true)
    [ -n "$version" ] || version="0"
    found=1
    if [ -z "$best_path" ]; then
      best_path="$proot"
      best_version="$version"
      continue
    fi
    cmp=$(ver_cmp "$version" "$best_version")
    if [ "$cmp" = "gt" ]; then
      best_path="$proot"
      best_version="$version"
    elif [ "$cmp" = "eq" ] && path_gt "$proot" "$best_path"; then
      best_path="$proot"
      best_version="$version"
    fi
  done <<EOF
$(find "$root" -type f -path '*/.claude-plugin/plugin.json' 2>/dev/null)
EOF

  [ "$found" = "1" ] || return 1
  printf '%s\n' "$best_path"
}

subcmd="${1:-}"
case "$subcmd" in
  deliver-check | conduct-check | screens-check) ;;
  *)
    echo "devkit-kit: unknown subcommand '${subcmd}' (expected deliver-check, conduct-check or screens-check)" >&2
    exit 3
    ;;
esac
shift

script=""

if [ "$subcmd" = "screens-check" ]; then
  checkout_rel="plugins/compozy/skills/screen-design/scripts/screens-check.mjs"
  installed_rel="skills/screen-design/scripts/screens-check.mjs"

  if dir=$(find_repo_checkout "$checkout_rel"); then
    script="$dir/$checkout_rel"
  elif dir=$(find_installed devkit-compozy "$installed_rel"); then
    script="$dir/$installed_rel"
  else
    cat >&2 <<MSG
devkit-kit: no screens-check found. Tried:
  - repository checkout: $checkout_rel, walking up from $PWD
  - installed devkit-compozy: under $(plugins_dir), with a $installed_rel sibling
MSG
    exit 3
  fi
else
  checkout_rel="plugins/openspec/hooks/$subcmd.mjs"
  installed_rel="hooks/$subcmd.mjs"

  if [ -n "${DEVKIT_HOOKS:-}" ] && [ -f "$DEVKIT_HOOKS/$subcmd.mjs" ]; then
    script="$DEVKIT_HOOKS/$subcmd.mjs"
  elif dir=$(find_repo_checkout "$checkout_rel"); then
    script="$dir/$checkout_rel"
  elif dir=$(find_installed devkit-openspec "$installed_rel"); then
    script="$dir/$installed_rel"
  else
    cat >&2 <<MSG
devkit-kit: no $subcmd found. Tried:
  - \$DEVKIT_HOOKS: ${DEVKIT_HOOKS:-(unset)}
  - repository checkout: $checkout_rel, walking up from $PWD
  - installed devkit-openspec: under $(plugins_dir), with a $installed_rel sibling
MSG
    exit 3
  fi
fi

exec node "$script" "$@"
